---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  /** hex値（案件テーマカラー）または 'var(--accent)' などのCSS色 */
  themeColor: string;
}

const { src, alt, width, height, themeColor } = Astro.props;

// 旧実装の hex+アルファ接尾辞（cc/66/45）と等価のアルファを color-mix で表現する。
// CSS変数（var(--accent)）をテーマカラーに渡せるようにするための変更。
const tint = (percent: number) => `color-mix(in srgb, ${themeColor} ${percent}%, transparent)`;
---

<div class="duotone-wrapper">
  {/* Layer 4 (bottom): base image with grayscale + brightness + contrast */}
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    class="duotone-image"
    loading="lazy"
  />
  {/* Layer 3: color tint — mix-blend-mode: color */}
  <div
    class="duotone-layer duotone-color"
    style={`background: linear-gradient(to bottom, ${tint(80)} 0%, ${tint(40)} 100%);`}
    aria-hidden="true"
  />
  {/* Layer 2: color overlay — mix-blend-mode: overlay */}
  <div
    class="duotone-layer duotone-overlay"
    style={`background: linear-gradient(to bottom, ${tint(27)} 0%, transparent 100%);`}
    aria-hidden="true"
  />
  {/* Layer 1 (top): bottom fade gradient */}
  <div
    class="duotone-layer duotone-fade"
    aria-hidden="true"
  />
</div>

<style>
  .duotone-wrapper {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .duotone-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* ダーク: brightness(0.6) / ライト: brightness(0.85)（明背景での黒沈み防止） */
    filter: var(--duotone-img-filter);
  }

  .duotone-layer {
    position: absolute;
    inset: 0;
  }

  .duotone-color {
    mix-blend-mode: color;
    opacity: var(--duotone-tint-opacity);
  }

  .duotone-overlay {
    mix-blend-mode: overlay;
    opacity: var(--duotone-tint-opacity);
  }

  .duotone-fade {
    background: linear-gradient(to bottom, transparent 50%, var(--card-fade) 100%);
    mix-blend-mode: normal;
  }

  @media (prefers-reduced-transparency: reduce) {
    .duotone-color,
    .duotone-overlay {
      display: none;
    }

    .duotone-image {
      filter: grayscale(50%) brightness(0.8);
    }
  }
</style>
