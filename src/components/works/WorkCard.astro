---
import DuotoneImage from '../common/DuotoneImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  thumbnail: ImageMetadata;
  serviceCategory: string[];
  themeColor?: string;
  technologies?: string[];
}

const {
  slug,
  title,
  description,
  thumbnail,
  serviceCategory,
  themeColor = 'var(--accent)',
  technologies,
} = Astro.props;

const categoryLabels: Record<string, string> = {
  'system-development': 'システム開発',
  'web-development': 'HP開発・運用',
  'business-planning': '経営企画',
  'video-editing': '動画編集',
};
---

<a href={`/works/${slug}`} class="work-card">
  <div class="card-image">
    <DuotoneImage
      src={thumbnail}
      alt={title}
      width={400}
      height={225}
      themeColor={themeColor}
    />
  </div>
  <div class="card-body">
    <div class="card-tags">
      {serviceCategory.map((cat) => (
        <span class="card-tag">{categoryLabels[cat] ?? cat}</span>
      ))}
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>
    {technologies && technologies.length > 0 && (
      <div class="card-techs">
        {technologies.map((tech) => <span class="card-tech">{tech}</span>)}
      </div>
    )}
    <span class="card-link">詳しく見る →</span>
  </div>
</a>

<style>
  .work-card {
    display: block;
    background: var(--card-bg);
    backdrop-filter: blur(var(--glass-blur, 20px)) saturate(var(--glass-saturate, 200%));
    -webkit-backdrop-filter: blur(var(--glass-blur, 20px)) saturate(var(--glass-saturate, 200%));
    border: 1px solid var(--card-border);
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--card-shadow);
  }

  .work-card:hover {
    transform: translateY(-4px);
    border-color: var(--card-border-hover);
    box-shadow: var(--card-shadow-hover);
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
  }

  /* backdrop-filter creates stacking context — directly apply radius to duotone-wrapper */
  .card-image :global(.duotone-wrapper) {
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
  }

  .card-body {
    padding: 24px 28px;
  }

  .card-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .card-tag {
    font-size: 0.625rem;
    padding: 3px 10px;
    border-radius: 9999px;
    background: var(--accent-soft);
    color: var(--text-accent);
    letter-spacing: 0.05em;
    font-family: 'Jost', sans-serif;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0 0 8px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    font-family: 'Jost', 'Sawarabi Gothic', sans-serif;
  }

  .card-description {
    font-size: 0.8125rem;
    color: var(--text-sub);
    margin: 0 0 16px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-techs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .card-tech {
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .card-link {
    font-size: 0.75rem;
    color: var(--text-accent);
    font-family: 'Jost', sans-serif;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }

  .work-card:hover .card-link {
    color: var(--accent-hover);
  }

  @media (prefers-reduced-transparency: reduce) {
    .work-card {
      background: var(--opaque-surface);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
